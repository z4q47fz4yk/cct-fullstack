# 通常不需要手工创建：每个 worktree 运行 scripts/worktree-env.sh 自动生成 .env。
# 该文件仅用于说明变量语义。
#
# 每个 worktree 独立一份，存放在仓库根（已被 .gitignore 忽略）。
# 前后端/docs 共用同一份 ⇒ 端口一一对应，前端永远访问自己 worktree 的后端。

# 后端服务端口（fastapi dev --port）
BACKEND_PORT=8000
# 前端 dev server 端口（vite server.port，strictPort 冲突即报错）
FRONTEND_PORT=5173
# 文档站 vitepress dev 端口（前端 /docs 代理指向它）
DOCS_PORT=5174
# 前端访问后端的基址：dev 默认同源 /api（vite 反代到 BACKEND_PORT）；如需跨机直连可改为 http://host:port（配合 CORS_ALLOW_ALL）
VITE_API_BASE=/api
# 开发期放开 CORS 允许任意来源（allow_origins=[*]；此时浏览器禁止携带凭据，allow_credentials=False）
CORS_ALLOW_ALL=true
# 可选：显式 CORS 白名单（CORS_ALLOW_ALL 为 false 时生效，逗号分隔）
#CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173
# 可选：数据库连接（默认沿用主 worktree 的 .env；多 worktree 并行开发时，
# 涉及迁移/数据的 agent 建议每个 worktree 使用独立库名，如 cctv2-wt2）
#DATABASE_URL=postgresql://cct:cct@localhost:5432/cctv2

# ---- OIDC 认证 / 会话（见 backend/src/config.py；敏感值勿提交，只进各 worktree 的 .env）----
# 会话 Cookie 签名密钥：生产必须替换为 32+ 字节随机值（`python -c "import secrets; print(secrets.token_urlsafe(48))"`）
#SESSION_SECRET_KEY=
# 会话有效期（秒），默认 14 天
#SESSION_MAX_AGE=1209600
# 会话 Cookie 路径（默认 /api，与浏览器侧 /api 前缀匹配；测试环境放开为 /）
#SESSION_COOKIE_PATH=/api
# 生产 HTTPS 必须设为 true；本地 http://localhost 开发保持 false（Secure Cookie 不会被 http 回传）
#SESSION_COOKIE_SECURE=false
# 是否允许 OIDC 新用户自动落库（false 时仅已有绑定可登录，新用户回跳“注册已关闭”）
#AUTH_ALLOW_NEW_USER_REGISTRATION=true
# 新用户默认角色（须为迁移种子角色之一：admin / guest）
#AUTH_DEFAULT_ROLE=guest
# 首次登录命中该邮箱白名单即授予 admin（逗号分隔，首位管理员引导，替代管理 UI）
#AUTH_ADMIN_EMAILS=admin@example.com
# 认证成功/失败回跳前端地址；缺省取 FRONTEND_PORT（dev 可用），部署必须显式配置
#AUTH_FRONTEND_URL=http://localhost:5175
# 全局登录门槛：true 时除 /auth、/docs 外一律要求登录（默认 false，业务路由保持开放）
#AUTH_REQUIRED=false
# 第三方登录 Provider 列表（JSON 数组；两种形态：
#   ① discovery_url —— OIDC 兼容提供商（Gitea/Google）；
#   ② authorize_url+token_url+userinfo_url —— 手动端点（GitHub 等），user_id_claim 用 id）
#OIDC_PROVIDERS=[{"name":"gitea","display_name":"Gitea","client_id":"xxx","client_secret":"yyy","scopes":"openid profile email","redirect_uri":"http://localhost:5175/api/auth/gitea/callback","discovery_url":"https://git.example.com/.well-known/openid-configuration"}]

# ---- Pi Agent（AI 对话 / 日报解析配置生成，见 backend/src/config.py）----
# 是否启用 AI 对话功能（false 时 /ai/chat 返回 503；启用前请先配置 provider/model/api-key）
#PI_ENABLED=true
# pi 可执行文件路径（缺省 "pi"，按 PATH 解析；由后端以 RPC 模式托管，内置工具如 bash 一律禁用）
#PI_BIN=pi
# LLM Provider（传给 pi --provider，如 opencode-go）
#PI_PROVIDER=opencode-go
# LLM 模型（传给 pi --model，如 deepseek-v4-flash）
#PI_MODEL=deepseek-v4-flash
# LLM API Key（写入 pi 子进程环境变量 OPENCODE_API_KEY；也可直接使用系统环境变量）
#PI_API_KEY=
# 自定义扩展文件路径（传给 pi -e，逗号分隔；缺省加载仓库内 backend/pi_extensions/daily-report-config.ts）
#PI_EXTENSIONS=backend/pi_extensions/daily-report-config.ts
# 扩展工具回调本后端内部端点的基址（缺省 http://127.0.0.1:BACKEND_PORT）
#PI_INTERNAL_BASE_URL=http://127.0.0.1:8000
# 内部端点鉴权令牌（缺省为空=仅本机开发；生产必须设置，扩展工具原样透传）
#PI_INTERNAL_TOKEN=