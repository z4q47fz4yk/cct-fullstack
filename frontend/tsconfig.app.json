{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "site.config.ts", "src/**/*", "src/**/*.vue", "typed-router.d.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@site": ["./site.config.ts"]
    }
  }
}
